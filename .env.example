GROQ_API_KEY="your_groq_api_key_here"

# Supabase (optional — enables cloud memory, multi-user, and semantic search).
# Create a free project at https://supabase.com, then copy the URL + anon key.
# If left empty, HADES uses local files (conversation_history.json + notes.txt).
SUPABASE_URL=
SUPABASE_ANON_KEY=
WEATHER_API_KEY="your_weather_api_key_here"
NEWS_API_KEY="your_news_api_key_here"
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
DEFAULT_CITY=Toronto
FACE_AUTH_ENABLED=false

# Path to your Piper TTS voice model (.onnx file).
# Download en_GB-alan-medium.onnx + en_GB-alan-medium.onnx.json (~60 MB) from:
#   https://huggingface.co/rhasspy/piper-voices/tree/main/en/en_GB/alan/medium
# Place both files in the ./voices/ directory, then set this to:
PIPER_MODEL=voices/en_GB-alan-medium.onnx

# Wake word(s) — comma-separated, first is primary.
# Built-in fuzzy variants are known for: hades, jarvis, friday.
# For any other word, variants are derived automatically.
WAKE_WORDS=hades

# Seconds to ignore a second wake-word trigger after the first.
# Prevents double-fire from echoes or STT picking up the word twice.
WAKE_DEBOUNCE=2.5

# ── Phase 14: Neural wake word ────────────────────────────────────────────────
# Set to false to force the old STT-based wake word polling (useful for debugging).
NEURAL_WAKE_WORD=true

# Optional path to a custom openwakeword .onnx model trained on your wake word.
# Leave empty to use all built-in default models (e.g. hey_jarvis, alexa).
# Train a custom model at: https://github.com/dscripka/openWakeWord#training-new-models
WAKE_MODEL=

# ── Phase 15: Continuous conversation ────────────────────────────────────────
# Seconds of silence after a reply before HADES returns to standby.
# During this window the user can ask follow-up questions without re-saying the wake word.
FOLLOWUP_TIMEOUT=15

# ── Phase 16: Action confirmation gate ───────────────────────────────────────
# Seconds to wait for spoken confirmation on destructive commands (shutdown, restart,
# delete all notes). If no reply arrives within this window the action is auto-cancelled.
CONFIRM_TIMEOUT=10